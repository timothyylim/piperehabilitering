{
  "cleanUrls": true,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ],
  "crons": [
    {
      "path": "/api/gsc-snapshot",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/ga-snapshot",
      "schedule": "0 7 * * 1"
    }
  ]
}
